{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "superPlan-astra": {
      "description": "Independent planning subagent for superPlan using GPT-6 Astra",
      "mode": "subagent",
      "hidden": true,
      "model": "{env:OC_OPENAI}/gpt-6-astra",
      "steps": 8,
      "system": "{file:./prompts/superplan-planner.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "superPlan-opus": {
      "description": "Independent planning subagent for superPlan using Claude Opus 5.5",
      "mode": "subagent",
      "hidden": true,
      "model": "{env:OC_ANTHROPIC}/claude-opus-5.5",
      "steps": 8,
      "system": "{file:./prompts/superplan-planner.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "superPlan-sol": {
      "description": "Independent planning subagent for superPlan using GPT-6 Sol",
      "mode": "subagent",
      "hidden": true,
      "model": "{env:OC_OPENAI}/gpt-6-sol",
      "steps": 8,
      "system": "{file:./prompts/superplan-planner.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "plan-astra": {
      "description": "Read-only standalone planner using GPT-6 Astra",
      "mode": "subagent",
      "hidden": true,
      "model": "{env:OC_OPENAI}/gpt-6-astra",
      "steps": 12,
      "system": "{file:./prompts/plan-planner.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "plan-opus": {
      "description": "Read-only standalone planner using Claude Opus 5.5",
      "mode": "subagent",
      "hidden": true,
      "model": "{env:OC_ANTHROPIC}/claude-opus-5.5",
      "steps": 12,
      "system": "{file:./prompts/plan-planner.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "plan-sol": {
      "description": "Read-only standalone planner using GPT-6 Sol",
      "mode": "subagent",
      "hidden": true,
      "model": "{env:OC_OPENAI}/gpt-6-sol",
      "steps": 12,
      "system": "{file:./prompts/plan-planner.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "coder": {
      "model": "{env:OC_OPENAI}/gpt-5.6-terra"
    },
    "documentation": {
      "model": "{env:OC_OPENAI}/gpt-5.6-luna"
    },
    "superPlan": {
      "model": "{env:OC_ANTHROPIC}/claude-opus-4.8"
    },
    "review": {
      "model": "{env:OC_OPENAI}/gpt-6-astra"
    },
    "review-architecture": {
      "model": "{env:OC_OPENAI}/gpt-6-astra"
    },
    "review-data": {
      "model": "{env:OC_OPENAI}/gpt-6-astra"
    },
    "review-distributed": {
      "model": "{env:OC_OPENAI}/gpt-6-astra"
    },
    "review-general": {
      "model": "{env:OC_OPENAI}/gpt-6-astra"
    },
    "review-go": {
      "model": "{env:OC_OPENAI}/gpt-6-astra"
    },
    "chat": {
      "model": "{env:OC_OPENAI}/gpt-5.5#low"
    },
    "fast": {
      "description": "Fast, low-cost delegation for narrow lookups, simple edits, summaries, and focused verification. Invoked with @fast.",
      "mode": "subagent",
      "model": "{env:OC_OPENAI}/gpt-5-mini#low"
    },
    "sonnet": {
      "description": "Balanced implementation and analysis for standard features, debugging, code review, and multi-file changes. Invoked with @sonnet.",
      "mode": "subagent",
      "model": "{env:OC_ANTHROPIC}/claude-sonnet-5#high"
    },
    "opus": {
      "description": "Deep reasoning for architecture, hard debugging, risky refactors, and adversarial review. Invoked with @opus.",
      "mode": "subagent",
      "model": "{env:OC_ANTHROPIC}/claude-opus-5.5#medium"
    },
    "astra": {
      "description": "Deep reasoning for architecture, hard debugging, risky refactors, and adversarial review. Invoked with @astra.",
      "mode": "subagent",
      "model": "{env:OC_OPENAI}/gpt-6-astra#medium"
    },
    "fable": {
      "description": "Deep reasoning for architecture, hard debugging, risky refactors, and adversarial review. Invoked with @fable.",
      "mode": "subagent",
      "model": "openrouter/anthropic/claude-fable-5.1#high"
    },
    "gpt55": {
      "description": "General high-capability implementation and reasoning for substantial coding or research tasks. Invoked with @gpt55.",
      "mode": "subagent",
      "model": "{env:OC_OPENAI}/gpt-5.5#xhigh"
    },
    "luna": {
      "description": "Latest Luna model for independent investigation, synthesis, and alternative problem-solving approaches. Invoked with @luna.",
      "mode": "subagent",
      "model": "{env:OC_OPENAI}/gpt-6-luna#high"
    },
    "terra": {
      "description": "Latest Terra model for deep, high-stakes implementation, complex systems work, and comprehensive debugging. Invoked with @terra.",
      "mode": "subagent",
      "model": "{env:OC_OPENAI}/gpt-5.6-terra#xhigh"
    },
    "sol": {
      "description": "Latest Sol model for complex implementation, validation, and second-opinion reviews. Invoked with @sol.",
      "mode": "subagent",
      "model": "{env:OC_OPENAI}/gpt-6-sol#high"
    }
  },
  "commands": {
    "bdexecissue": {
      "description": "execute a single bd issue",
      "model": "{env:OC_OPENAI}/gpt-5.6-terra",
      "template": "{file:./prompts/bdexecissue.md}"
    }
  },
  "instructions": [
    "~/.config/opencode/instructions/caveman.md"
  ],
  "lsp": {
    "gopls": {
      "command": [
        "gopls",
        "-remote=auto"
      ]
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_KEY}"
        },
        "disabled": false
      },
      "engram": {
        "command": [
          "engram",
          "mcp",
          "--tools=agent"
        ],
        "type": "local",
        "disabled": false
      },
      "chiasmus": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chiasmus"
        ],
        "environment": {
          "CHIASMUS_LOCAL_EMBED": "1",
          "CHIASMUS_LOCAL_EMBED_MODEL": "hf:Qwen/Qwen3-Embedding-0.6B-GGUF",
          "CHIASMUS_LOCAL_EMBED_DIM": "1024"
        },
        "disabled": false
      }
    }
  },
  "plugins": [
    "opencode-beads",
    "@dietrichgebert/ponytail"
  ]
}
