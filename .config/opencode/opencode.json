{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-beads"],
  "instructions": [
    "~/.config/opencode/instructions/cass.md",
    "~/.config/opencode/instructions/caveman.md"
  ],
  "lsp": {
    "gopls": {
      "command": ["gopls", "-remote=auto"]
    }
  },
  "mcp": {
    "gremlin": {
      "type": "local",
      "command": ["gremlin-mcp"],
      "environment": {
        "GREMLIN_URL": "ws://localhost:8182/gremlin"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_KEY}"
      },
      "enabled": true
    },
    "mcp-atlassian": {
      "type": "local",
      "command": ["uvx", "--with", "packaging", "mcp-atlassian"],
      "environment": {
        "JIRA_URL": "https://hashicorp.atlassian.net",
        "JIRA_USERNAME": "John.Maguire3@ibm.com",
        "JIRA_API_TOKEN": "{env:JIRA_TOKEN}"
      },
      "enabled": false
    },
    "ibm-slack-mcp": {
      "type": "local",
      "command": ["ibm-slack-mcp"],
      "environment": {
        "SLACK_EXCLUDE_DMS": "false",
        "SLACK_EXCLUDE_PRIVATE_CHANNELS": "false",
        "SLACK_EXCLUDE_GROUP_DMS": "false",
        "SLACK_EXCLUDE_CHANNELS": "",
        "SLACK_EXCLUDE_USERS": ""
      },
      "enabled": false
    }
  },

  "agent": {
    "superPlan-gpt55": {
      "description": "Independent planning subagent for superPlan using GPT-5.5",
      "mode": "subagent",
      "hidden": true,
      "model": "github-copilot/gpt-5.5",
      "temperature": 0.2,
      "steps": 8,
      "prompt": "{file:./prompts/superplan-planner.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "webfetch": false,
        "task": false
      }
    },
    "superPlan-gemini31": {
      "description": "Independent planning subagent for superPlan using Gemini 3.1 Pro Preview",
      "mode": "subagent",
      "hidden": true,
      "model": "github-copilot/gemini-3.1-pro-preview",
      "temperature": 0.2,
      "steps": 8,
      "prompt": "{file:./prompts/superplan-planner.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "webfetch": false,
        "task": false
      }
    },
    "superPlan-opus47": {
      "description": "Independent planning subagent for superPlan using Claude Opus 4.8",
      "mode": "subagent",
      "hidden": true,
      "model": "github-copilot/claude-opus-4.8",
      "temperature": 0.2,
      "steps": 8,
      "prompt": "{file:./prompts/superplan-planner.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "webfetch": false,
        "task": false
      }
    }
  },
  "tools": {
    "skill": true
  }
}
