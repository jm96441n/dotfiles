{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-beads"],
  "instructions": ["~/.config/opencode/instructions/caveman.md"],
  "lsp": {
    "gopls": {
      "command": ["gopls", "-remote=auto"]
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "/home/johnmaguire/.local/share/mise/installs/node/23.11.0/bin/codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "gremlin": {
      "type": "local",
      "command": ["gremlin-mcp"],
      "environment": {
        "GREMLIN_URL": "ws://localhost:8182/gremlin"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_KEY}"
      },
      "enabled": true
    },
    "mcp-atlassian": {
      "type": "local",
      "command": ["uvx", "--with", "packaging", "mcp-atlassian"],
      "environment": {
        "JIRA_URL": "https://hashicorp.atlassian.net",
        "JIRA_USERNAME": "John.Maguire3@ibm.com",
        "JIRA_API_TOKEN": "{env:JIRA_TOKEN}"
      },
      "enabled": false
    },
    "ibm-slack-mcp": {
      "type": "local",
      "command": ["ibm-slack-mcp"],
      "environment": {
        "SLACK_EXCLUDE_DMS": "false",
        "SLACK_EXCLUDE_PRIVATE_CHANNELS": "false",
        "SLACK_EXCLUDE_GROUP_DMS": "false",
        "SLACK_EXCLUDE_CHANNELS": "",
        "SLACK_EXCLUDE_USERS": ""
      },
      "enabled": false
    }
  },

  "agent": {
    "superPlan-glm52": {
      "description": "Independent planning subagent for superPlan using GLM 5.2",
      "mode": "subagent",
      "hidden": true,
      "model": "openrouter/z-ai/glm-5.2",
      "temperature": 0.2,
      "steps": 8,
      "prompt": "{file:./prompts/superplan-planner.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "webfetch": false,
        "task": false
      }
    },
    "superPlan-kimiK3": {
      "description": "Independent planning subagent for superPlan using Kimi K3",
      "mode": "subagent",
      "hidden": true,
      "model": "openrouter/moonshotai/kimi-k3",
      "temperature": 0.2,
      "steps": 8,
      "prompt": "{file:./prompts/superplan-planner.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "webfetch": false,
        "task": false
      }
    },
    "superPlan-deepseekV4Pro": {
      "description": "Independent planning subagent for superPlan using DeepSeek V4 Pro",
      "mode": "subagent",
      "hidden": true,
      "model": "openrouter/deepseek/deepseek-v4-pro",
      "temperature": 0.2,
      "steps": 8,
      "prompt": "{file:./prompts/superplan-planner.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "webfetch": false,
        "task": false
      }
    },
    "plan-glm": {
      "description": "Read-only standalone planner using GLM 5.2",
      "mode": "subagent",
      "hidden": true,
      "model": "openrouter/z-ai/glm-5.2",
      "temperature": 0.2,
      "steps": 12,
      "prompt": "{file:./prompts/plan-planner.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "webfetch": false,
        "task": false,
        "question": false
      }
    },
    "plan-kimi": {
      "description": "Read-only standalone planner using Kimi K3",
      "mode": "subagent",
      "hidden": true,
      "model": "openrouter/moonshotai/kimi-k3",
      "temperature": 0.2,
      "steps": 12,
      "prompt": "{file:./prompts/plan-planner.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "webfetch": false,
        "task": false,
        "question": false
      }
    }
  },
  "tools": {
    "skill": true
  }
}
