#!/usr/bin/zsh

BIN_NAME=$(basename "$0")
COMMAND_NAME=$1
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"

sub_help() {
  echo "Usage: $BIN_NAME <command>"
  echo
  echo "Commands:"
  echo "   clean            Clean up caches (dnf, nix, mise)"
  echo "   edit             Open dotfiles in \$EDITOR"
  echo "   help             This help message"
  echo "   switch           Apply home-manager config"
  echo "   update           Update dnf, flake inputs, home-manager, mise"
}

sub_edit() {
  ${EDITOR:-nvim} "$DOTFILES_DIR"
}

sub_switch() {
  home-manager switch --flake "$DOTFILES_DIR#$USER"
}

sub_update() {
  sudo dnf upgrade
  nix flake update --flake "$DOTFILES_DIR"
  sub_switch
  mise upgrade
}

sub_clean() {
  sudo dnf clean all
  nix-collect-garbage -d
  mise prune
}

# Keep in sync with public commands
sub_completion() {
  echo "clean edit help switch update"
}

case $COMMAND_NAME in
  "" | "-h" | "--help")
    sub_help
    ;;
  *)
    shift
    sub_${COMMAND_NAME} $@
    if [ $? = 127 ]; then
      echo "'$COMMAND_NAME' is not a known command or has errors." >&2
      sub_help
      exit 1
    fi
    ;;
esac
